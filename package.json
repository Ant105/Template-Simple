{
  "name": "cli-build-project",
  "version": "1.0.0",
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "postcss": "npx postcss styles.css -o styles.min.css",
    "babel": "npx babel main.js -o main.babel.js",
    "minify-js": "npx terser main.js --config-file .terserrc -o main.min.js",
    "minify-html": "npx html-minifier-next --collapse-whitespace --conservative-collapse --remove-comments -o index.html index.html",
    "eslint": "npx eslint main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "cssnano": "^7.1.2",
    "doiuse": "^6.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^6.0.2",
    "globals": "^17.0.0",
    "html-minifier-next": "^4.8.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^10.5.0",
    "terser": "^5.44.1"
  },
  "dependencies": {
    "core-js": "^3.47.0"
  }
}
